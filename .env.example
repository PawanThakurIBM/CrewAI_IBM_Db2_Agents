# IBM Db2
DB2_HOST=your-db2-hostname
DB2_PORT=50000
DB2_DATABASE=CREWAI
DB2_USERNAME=your-username
DB2_PASSWORD=your-password
DB2_PROTOCOL=TCPIP
DB2_SCHEMA=AIRLINE_KB

# External APIs
OPENWEATHER_API_KEY=
AVIATIONSTACK_API_KEY=
SENDGRID_API_KEY=       # optional, notification only

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=granite3.3:8b

# Haystack / Embeddings
# NOTE: changing EMBEDDING_MODEL requires re-running: python scripts/ingest_knowledge.py --wipe
EMBEDDING_MODEL=ibm-granite/granite-embedding-125m-english
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RETRIEVAL_TOP_K=10
RERANKER_TOP_K=5
DATA_DIR=src/data

# App
LOG_LEVEL=INFO
APP_ENV=development
