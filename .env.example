# ── LLM ──────────────────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=granite3.3

# ── External APIs ─────────────────────────────────────────────────────────────
OPENWEATHER_API_KEY=your_openweather_api_key_here
AVIATIONSTACK_API_KEY=your_aviationstack_api_key_here
SENDGRID_API_KEY=your_sendgrid_api_key_here        # optional, for notifications

# ── IBM Db2 (Pawan's side — required for knowledge retrieval) ─────────────────
DB2_HOST=your_db2_host
DB2_PORT=50000
DB2_DATABASE=AIRLINE
DB2_USERNAME=your_db2_username
DB2_PASSWORD=your_db2_password
DB2_SCHEMA=AIRLINE_KB

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
